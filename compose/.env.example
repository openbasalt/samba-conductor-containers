# Copy to .env and edit. No secrets here: they are files in ./secrets
# (./make-secrets.sh).

# The domain (DNS name; the Kerberos realm is its upper-case form), its
# NetBIOS name and the DC's host name.
SC_DNS_DOMAIN=example.test
SC_NETBIOS=EXAMPLE
SC_HOSTNAME=dc1
# This host's address that clients use: the ports are published there and
# DNS records carry it.
SC_HOST_IP=192.0.2.10
# Upstream resolvers for names outside the domain (space-separated).
SC_DNS_FORWARDERS=192.0.2.1
# The stack's bridge network (/24 prefix) and SELinux MCS level. The other
# services reach the DC at SC_DC_ADDRESS (default: its address on that
# network; with addons/host-network.yaml: SC_HOST_IP).
SC_NET=172.30.93
# SC_DC_ADDRESS=192.0.2.10
SC_MCS_LEVEL=s0:c93,c94
# TLS: self-signed (the DC creates a CA constrained to the domain and
# SC_HOST_IP) or provided (addons/provided-tls.yaml and its secrets).
SC_TLS=self-signed
# Images: the registry (docker.io/openbasalt/ or ghcr.io/openbasalt/, same
# digests; empty for images built with ./build-local.sh) and the tag. The
# default tag is this checkout's release; "testing" is the channel of a
# release under test. Pin a digest in production (IMAGES.txt of the release).
SC_IMAGE_PREFIX=docker.io/openbasalt/
SC_TAG=0.1.1
# conductor's URL (also the WebAuthn RP ID); conductor.<domain> gets a
# certificate from the DC's self-signed CA.
# SC_PUBLIC_URL=https://conductor.example.test:8443
# SC_HELPDESK_GROUP=Helpdesk
# SC_AUDITOR_GROUP=Auditors

# Add-ons (colon-separated, compose.yaml first):
# COMPOSE_FILE=compose.yaml:addons/idp.yaml:addons/sync.yaml:addons/backup.yaml
