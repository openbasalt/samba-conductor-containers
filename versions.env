# Inputs of an image build; changing any of them is a pull request. Read by
# build-local.sh and the release workflow and passed as build
# arguments.

# Image version (the containers release). The DC image carries conductor's
# version too, because conductor-helper inside it must match conductor.
IMAGE_VERSION=0.2.0
# Rebuild counter, shared by the six images: the -rN of the image tags.
# A rebuild for base or Debian updates raises it, and so does a release
# that keeps a component's version (its <component>-r<N> tag exists
# already and is never overwritten). 2: conductor-sync and
# conductor-backup stay at 0.1.0-1 in 0.1.1. 4: conductor-idp and
# conductor-backup keep the versions of 0.1.2 (r3) in 0.2.0.
IMAGE_REVISION=4

# Component packages, exactly as published in the OpenBasalt APT repository
# (https://obpkg.org/apt), verified through the signed InRelease of each
# suite with keys/openbasalt-release-key.gpg. APT_SUITE lists the suites
# searched in order (space-separated): each package comes from the first
# suite that publishes that exact version. A release under test takes its
# new packages from "testing" and the unchanged ones from "stable".
CONDUCTOR_VERSION=0.2.0-1
IDP_VERSION=0.1.1-1
SYNC_VERSION=0.2.0-1
BACKUP_VERSION=0.1.0-1
PROVISIONER_VERSION=0.1.0-1
APT_URL=https://obpkg.org/apt
APT_SUITE="testing stable"

# Debian packages come from this snapshot.debian.org timestamp (Samba and
# every other package of the DC and conductor images); empty = the live
# Debian mirrors (local experiments only).
DEBIAN_SNAPSHOT=20261123T000000Z

# BuildKit frontend that parses images/Containerfile, pinned by digest. A
# "# syntax=" line cannot read build arguments, so the Containerfile carries
# the same value on its first line; make check (scripts/check-frontend-pin.sh)
# keeps the two equal.
DOCKERFILE_FRONTEND=docker/dockerfile:1.10@sha256:865e5dd094beca432e8c0a1d5e1c465db5f998dca4e439981029b3b81fb39ed5

# Base images, pinned by digest.
DEBIAN_IMAGE=debian:13-slim@sha256:a72b4433de1cf7d6bae0c4cee74d0547f58601a643b3375f070c51600d63b6b2
DISTROLESS_IMAGE=gcr.io/distroless/static-debian13:nonroot@sha256:8ce6dd87e9823c5b48dcfb2c8604714ccb351ce59607327bcc4957448da279b5
GO_IMAGE=golang:1.27.4-trixie@sha256:f18c3d73a184fb0582828510722e723b63a93f7188d11dd223d9be6f6880e65d
