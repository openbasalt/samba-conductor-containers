# Inputs of an image build; changing any of them is a pull request. Read by
# build-local.sh and the release workflow and passed as build
# arguments.

# Image version (the containers release). The DC image carries conductor's
# version too, because conductor-helper inside it must match conductor.
IMAGE_VERSION=0.0.0-dev
# Rebuild counter of the same component versions: the -rN of the image
# tags (a rebuild for base or Debian updates raises it).
IMAGE_REVISION=1

# Component packages, exactly as published in the OpenBasalt APT repository
# (https://obpkg.org/apt, suite stable), verified through the signed
# InRelease with keys/openbasalt-release-key.gpg.
CONDUCTOR_VERSION=0.0.0+git20261005204931.ec7bcc9faef6-1
IDP_VERSION=0.0.0+git20261005204933.678a0f60cd85-1
SYNC_VERSION=0.0.0+git20261005175505.d66356c382d9-1
BACKUP_VERSION=0.0.0+git20261004164232.8b4493c5ec80-1
APT_URL=https://obpkg.org/apt
APT_SUITE=stable

# Debian packages come from this snapshot.debian.org timestamp (Samba and
# every other package of the DC and conductor images); empty = the live
# Debian mirrors (local experiments only).
DEBIAN_SNAPSHOT=20261008T000000Z

# Base images, pinned by digest.
DEBIAN_IMAGE=debian:13-slim@sha256:a99cfc517144bc59b1978475ec53b46ecabec7e43635402ee5b77cc54cd1b20a
DISTROLESS_IMAGE=gcr.io/distroless/static-debian13:nonroot@sha256:e2e927ec666bae08560abb3c55d0659eceabb657f56b6782ab500a9fc7f555e3
GO_IMAGE=golang:1.27.2-trixie@sha256:e58d6f83b3416618d8bcac2b3dde1b7f7e3c4a77d25e88637f8bbae81536c48d
